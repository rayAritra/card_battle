# Etherscan Multichain V2 — one key covers Ethereum (1) and Base (8453)
ETHERSCAN_API_KEY=

# Alchemy — token balances and metadata, also used as the ENS RPC transport
ALCHEMY_API_KEY=

# Supabase — API response cache, computed cards, battles, flavor cache
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis — per-IP rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Absent, flavor text falls back to static templates.
LLM_API_KEY=

# Absolute origin used for OG image and share URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
