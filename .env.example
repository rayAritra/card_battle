# Etherscan Multichain V2. Free plan covers Ethereum only; Base history falls
# back to Alchemy automatically. A paid plan restores richer Base data.
ETHERSCAN_API_KEY=

# Alchemy — token balances and metadata, the ENS RPC transport, and the Base
# history source. Enable BOTH Ethereum Mainnet and Base Mainnet on the app.
ALCHEMY_API_KEY=

# Supabase — API response cache, computed cards, battles, flavor cache
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis — per-IP rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Absent, flavor text falls back to static templates.
LLM_API_KEY=

# Absolute origin used for OG image and share URLs
# Signed per-domain association from the Farcaster custody account. Without it
# the app still renders as a frame, it just cannot be installed as a Mini App.
FARCASTER_ACCOUNT_ASSOCIATION=

# Absolute origin used for OG image and share URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
